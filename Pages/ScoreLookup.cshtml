                { id: 2, name: "Nguyễn Trọng", uni: "Học sinh lớp 12", score: "8.5", avatar: "/images/students/1790926754630_2065387549758146619_13551008470814114_643164bbd0f1d63e35c859d2fb2e0e5e.jpg", category: "IELTS" },
                { id: 3, name: "Phương Nam", uni: "Sinh viên ĐH KHTN", score: "7.5", avatar: "/images/students/1790926754643_2065387549758146619_13551008470814114_dac14a7fbc37d6510a0d72cbd9827ea5.jpg", category: "IELTS" },
                { id: 4, name: "Khánh Thiện", uni: "Học sinh xuất sắc", score: "7.5", avatar: "/images/students/1790926754654_2065387549758146619_13551008470814114_2e5456bfd81201ea46a75cc208957d9c.jpg", category: "THCS" },
                { id: 5, name: "Văn Thịnh", uni: "Học viên tiêu biểu", score: "8.0", avatar: "/images/students/1790926754663_2065387549758146619_13551008470814114_ba7097924c37fcff799013c0dd2b9695.jpg", category: "IELTS" },
                { id: 6, name: "Hoàng Phúc", uni: "Tăng 2.0 Band sau 3 tháng", score: "8.0", avatar: "/images/students/1790926754672_2065387549758146619_13551008470814114_48ac4dc79b46456808d7e21d3a6a4df9.jpg", category: "THCS" },
                { id: 7, name: "Hiển Long", uni: "Lớp 12 Đào Sơn Tây", score: "5.5+", avatar: "/images/students/1790926754694_2065387549758146619_13551008470814114_a06e0d4957e3ec532ebb3d86b46e4e0b.jpg", category: "IELTS" },
                { id: 8, name: "Vũ Minh Tuấn", uni: "Sinh viên năm 1 ĐH FPT", score: "6.0", avatar: "/images/students/1790926754722_2065387549758146619_13551008470814114_0a65938dc9ce4086e9207cd83104178b.jpg", category: "SAT" },
                { id: 9, name: "Trịnh Hoàng Anh Khoa", uni: "Sinh viên năm 3 Bách Khoa", score: "8.0", avatar: "/images/students/1790926754731_2065387549758146619_13551008470814114_023f34b1627917dfd05342bbcbf3b15e.jpg", category: "SAT" },
                { id: 10, name: "Hoàng Hân", uni: "Đạt học bổng du học", score: "8.5", avatar: "/images/students/1790926754740_2065387549758146619_13551008470814114_0cd084537ea4b3e1c9ecf245ebd44d01.jpg", category: "IELTS" }
            ];
            
            function renderHof(data) {
                const grid = document.getElementById('hofGrid');
                if(!grid) return;
                
                let html = '';
                data.forEach(t => {
                    html += `
                        <div class="hof-card">
                            <div class="hof-img-container">
                                <div class="ribbon">
                                    <span class="ribbon-score">${t.score}</span>
                                    <span class="ribbon-text">IELTS</span>
                                </div>
                                <img src="${t.avatar}" alt="${t.name}" class="hof-img">
                            </div>
                            <div class="hof-info">
                                <div class="hof-name">${t.name}</div>
                                <p class="hof-uni">${t.uni}</p>
                            </div>
                        </div>
                    `;
                });
                grid.innerHTML = html;
            }
            
            // Initial render
            renderHof(hofTeachers);
            
            // Setup filter
            const tabs = document.querySelectorAll('.hof-tab-btn');
            tabs.forEach(tab => {
                tab.addEventListener('click', function() {
                    tabs.forEach(t => t.classList.remove('active'));
                    this.classList.add('active');
                    
                    const cat = this.textContent.trim();
                    const filtered = hofTeachers.filter(t => t.category === cat);
                    renderHof(filtered.length > 0 ? filtered : hofTeachers); // Fallback nếu rỗng
                });
            });

            
            
            // COURSE DETAIL LOGIC
            window.showCourseDetail = function(detailId) {
                document.getElementById('courseListSection').style.display = 'none';
                
                // hide all details first
                document.querySelectorAll('.course-detail-view').forEach(el => {
                    el.style.display = 'none';
                });
                
                // show target detail
                document.getElementById('courseDetailsContainer').style.display = 'block';
                document.getElementById(detailId).style.display = 'block';
                
                // scroll to top of section
                document.querySelector('.timeline-section').scrollIntoView({ behavior: 'smooth', block: 'start' });
            };
            
            window.hideCourseDetail = function() {
                document.getElementById('courseDetailsContainer').style.display = 'none';
                document.getElementById('courseListSection').style.display = 'block';
                
                // hide all details
                document.querySelectorAll('.course-detail-view').forEach(el => {
                    el.style.display = 'none';
                });
                
                document.querySelector('.timeline-section').scrollIntoView({ behavior: 'smooth', block: 'start' });
            };

            // ACCORDION LOGIC
            const accordions = document.querySelectorAll('.accordion-card');
            accordions.forEach(acc => {
                const header = acc.querySelector('.accordion-header');
                header.addEventListener('click', () => {
                    // Close others
                    accordions.forEach(other => {
                        if (other !== acc && other.classList.contains('active')) {
                            other.classList.remove('active');
                            other.querySelector('.accordion-content').style.maxHeight = null;
                        }
                    });
                    
                    // Toggle current
                    acc.classList.toggle('active');
                    const content = acc.querySelector('.accordion-content');
                    if (acc.classList.contains('active')) {
                        content.style.maxHeight = content.scrollHeight + "px";
                    } else {
                        content.style.maxHeight = null;
                    }
                });
            });

            
            // IELTS Score Toggle Logic
            const btnToggleResult = document.getElementById('btnToggleResult');
            const finalIeltsResult = document.getElementById('finalIeltsResult');
            if (btnToggleResult && finalIeltsResult) {
                finalIeltsResult.addEventListener('show.bs.collapse', function () {
                    btnToggleResult.innerHTML = '<i class="bi bi-eye-slash-fill me-2"></i> Ẩn điểm thi cuối kỳ';
                });
                finalIeltsResult.addEventListener('hide.bs.collapse', function () {
                    btnToggleResult.innerHTML = '<i class="bi bi-award-fill me-2"></i> Hiển thị điểm thi cuối kỳ';
                });
            }

            // SEARCH LOGIC
            const searchForm = document.getElementById('searchForm');
            if (searchForm) {
                searchForm.addEventListener('submit', function(event) {
                    event.preventDefault();
                    const input = document.getElementById('searchInput').value.trim().toUpperCase();
                    const errorDiv = document.getElementById('searchError');
                    const resultSection = document.getElementById('searchResultsSection');
                    const hofSection = document.querySelector('.hall-of-fame-section');
                    const btn = searchForm.querySelector('button[type="submit"]');
                    const searchInput = document.getElementById('searchInput');
                    
                    if(errorDiv) errorDiv.style.display = 'none';
                    if(resultSection) resultSection.style.display = 'none';
                    
                    btn.disabled = true;
                    searchInput.disabled = true;
                    const originalBtnContent = btn.innerHTML;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>';
                    
                    setTimeout(() => {
                        btn.disabled = false;
                        searchInput.disabled = false;
                        btn.innerHTML = originalBtnContent;
                        
                        if (input === '521179' || input === 'DANG HUU NHA') {
                            if (hofSection) hofSection.style.display = 'none';
                            if (resultSection) {
                                resultSection.style.display = 'block';
                                resultSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
                            }
                        } else {
                            if(errorDiv) errorDiv.style.display = 'block';
                        }
                    }, 3000);
                });
            }
        });
    </script>
}
