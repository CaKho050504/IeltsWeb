@page "/lien-he"
@{
    ViewData["Title"] = "Liên hệ";
}

<style>
    .contact-hero {
        background-color: var(--primary-color);
        color: white;
        padding: 80px 0;
        text-align: center;
    }
    
    .contact-info-card {
        background: var(--bg-light);
        padding: 40px;
        border-radius: 12px;
        height: 100%;
    }
    
    .info-item {
        display: flex;
        margin-bottom: 25px;
    }
    
    .info-icon {
        width: 50px;
        height: 50px;
        background: var(--primary-color);
        color: var(--accent-color);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-right: 20px;
        flex-shrink: 0;
    }
    
    .contact-form-card {
        background: white;
        padding: 40px;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        border: 1px solid var(--border-color);
    }
</style>

<div class="contact-hero fade-in">
    <div class="container">
        <h1 class="fw-bold mb-3">Liên hệ với chúng tôi</h1>
        <p class="fs-5 opacity-75 max-w-700 mx-auto">Để lại thông tin, đội ngũ tư vấn viên sẽ liên hệ với bạn trong thời gian sớm nhất.</p>
    </div>
</div>

<div class="container py-5 fade-in">
    <div class="row g-5">
        <div class="col-lg-5">
            <div class="contact-info-card">
                <h3 class="fw-bold text-primary mb-4">Thông tin liên hệ</h3>
                
                <div class="info-item">
                    <div class="info-icon"><i class="bi bi-geo-alt-fill"></i></div>
                    <div>
                        <h5 class="fw-bold mb-1">Địa chỉ</h5>
                        <p class="text-muted mb-0">123 Đường ABC, Quận XYZ, TP. Hồ Chí Minh</p>
                    </div>
                </div>
                
                <div class="info-item">
                    <div class="info-icon"><i class="bi bi-telephone-fill"></i></div>
                    <div>
                        <h5 class="fw-bold mb-1">Hotline</h5>
                        <p class="text-muted mb-0">1900 1234</p>
                    </div>
                </div>
                
                <div class="info-item">
                    <div class="info-icon"><i class="bi bi-envelope-fill"></i></div>
                    <div>
                        <h5 class="fw-bold mb-1">Email</h5>
                        <p class="text-muted mb-0">support@ieltshub.edu.vn</p>
                    </div>
                </div>
                
                <div class="info-item">
                    <div class="info-icon"><i class="bi bi-clock-fill"></i></div>
                    <div>
                        <h5 class="fw-bold mb-1">Giờ làm việc</h5>
                        <p class="text-muted mb-0">Thứ 2 - Thứ 7: 08:00 - 21:00<br>Chủ nhật: 08:00 - 17:00</p>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-lg-7">
            <div class="contact-form-card">
                <h3 class="fw-bold text-primary mb-4">Đăng ký tư vấn miễn phí</h3>
                <form onsubmit="event.preventDefault(); alert('Đăng ký thành công! Chúng tôi sẽ liên hệ sớm.'); this.reset();">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Họ và tên *</label>
                            <input type="text" class="form-control p-3 bg-light border-0" required placeholder="Nhập họ và tên">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Số điện thoại *</label>
                            <input type="tel" class="form-control p-3 bg-light border-0" required placeholder="Nhập số điện thoại">
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-bold">Email</label>
                            <input type="email" class="form-control p-3 bg-light border-0" placeholder="Nhập địa chỉ email">
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-bold">Trình độ hiện tại (Dự đoán)</label>
                            <select class="form-select p-3 bg-light border-0">
                                <option value="">Chưa biết / Mất gốc</option>
                                <option value="4.0">Khoảng 4.0</option>
                                <option value="5.0">Khoảng 5.0</option>
                                <option value="6.0">Khoảng 6.0</option>
                                <option value="6.5+">Trên 6.5</option>
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-bold">Khóa học quan tâm</label>
                            <select class="form-select p-3 bg-light border-0">
                                <option value="Foundation">IELTS Foundation</option>
                                <option value="5.0">IELTS 5.0+</option>
                                <option value="6.5">IELTS 6.5+</option>
                                <option value="Intensive">IELTS Intensive</option>
                                <option value="Tuvan">Cần tư vấn thêm</option>
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-bold">Ghi chú thêm</label>
                            <textarea class="form-control p-3 bg-light border-0" rows="3" placeholder="Bạn có yêu cầu gì thêm không?"></textarea>
                        </div>
                        <div class="col-12 mt-4">
                            <button type="submit" class="btn-primary-custom w-100 fs-5 py-3">GỬI YÊU CẦU</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
