<section class="section-padding bg-white " id="phuong-phap" style="padding: 80px 0;">
<div class="container">
<div class="text-center">
<h2 class="section-title-large">Hệ Phương Pháp Linearthinking</h2>
<p class="section-subtitle" style="margin-bottom: 48px;">Độc quyền, thông minh, giúp rút ngắn 1/2 thời gian học.</p>
