@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Render Teachers Slider
            const sliderWrapper = document.getElementById('teacherSliderWrapper');
            if (sliderWrapper && typeof dolTeachers !== 'undefined') {
                let html = '';
                dolTeachers.forEach(teacher => {
                    html += `
                        <div class="swiper-slide">
                            <div class="teacher-slider-card">
                                <div class="teacher-image-box" style="background-color: ${teacher.bgColor};">
                                    <img src="${teacher.avatar}" alt="${teacher.name}" class="t-img" />
                                    <div class="score-overlay">${teacher.ielts_overall} IELTS Overall</div>
                                </div>
                                <div class="teacher-slider-info text-center mt-3">
                                    <h4 class="fw-800 text-heading mb-1" style="font-size: 18px;">${teacher.name}</h4>
                                    <p class="text-muted mb-0" style="font-size: 13px;">${teacher.title}</p>
                                </div>
                            </div>
                        </div>
                    `;
                });
                sliderWrapper.innerHTML = html;

                // Init Swiper
                new Swiper('.teacherSwiper', {
                    slidesPerView: 1.5,
                    spaceBetween: 20,
                    loop: true,
                    centeredSlides: false,
                    navigation: {
                        nextEl: '.swiper-next',
                        prevEl: '.swiper-prev',
                    },
                    breakpoints: {
                        576: { slidesPerView: 2.5, spaceBetween: 20 },
                        768: { slidesPerView: 3.5, spaceBetween: 24 },
                        1024: { slidesPerView: 4.5, spaceBetween: 24 }
                    }
                });
            }

            // (Other animations from site.js are still active)
        });
    </script>
}

